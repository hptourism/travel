# Public contact details. These are safe to show on the website.
NEXT_PUBLIC_SITE_NAME=Himalayan Travels (North India)
NEXT_PUBLIC_SITE_SHORT=HP Tourism
NEXT_PUBLIC_SITE_URL=https://hptourism.in
NEXT_PUBLIC_EMAIL=northhimalayantravels@gmail.com
# 10-digit Indian numbers are fine. The site adds 91 for WhatsApp.
# You can also store the full number, for example 919876543210.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_FLEET_STAND=PU Block, Pitampura, Delhi
NEXT_PUBLIC_OFFICE_SHORT=NSP, Pitampura, Delhi
NEXT_PUBLIC_OFFICE_ADDRESS=914, Aggarwal Cyber Plaza 1, Netaji Subhash Place, Pitampura, Delhi - 110034
NEXT_PUBLIC_OFFICE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=914+Aggarwal+Cyber+Plaza+1+Netaji+Subhash+Place+Pitampura+Delhi
NEXT_PUBLIC_FLEET_MAPS_URL=https://www.google.com/maps/search/?api=1&query=PU+Block+Pitampura+Delhi

# Google Tag Manager container ID from tagmanager.google.com (GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=GTM-P86QS2XP

# Enquiry modal auto popup. Set to off to disable. Delay is in seconds.
NEXT_PUBLIC_ENQUIRY_AUTO_POPUP=on
NEXT_PUBLIC_ENQUIRY_AUTO_POPUP_SECONDS=10

# Pushover. Create an application at https://pushover.net/apps/build
# User key is on the Pushover dashboard. Keep both of these private.
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
